---
import '../styles/global.css';
import { languages, getLanguageByCode } from '../i18n/languages';
import { getPricingTiers } from '../features/pricing/getPricingTiers';

interface Props {
  title: string;
  description: string;
  currentLang?: string;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title,
  description,
  currentLang = 'en',
  canonicalURL = Astro.url.href,
  ogImage = '/og-image.png'
} = Astro.props;

const siteName = 'TranslitPro';
const fullTitle = `${title} | ${siteName}`;
const currentLanguage = getLanguageByCode(currentLang);
const langDir = currentLanguage?.dir || 'ltr';

/**
 * List of supported language codes that can be requested via the `?lang=` query parameter.
 * This is embedded into the client-side redirect script.
 */
const supportedLangCodes = languages.map((lang) => lang.code);

/**
 * Prices for the `SoftwareApplication` structured data below. Read from the
 * pricing module rather than written inline: the hardcoded copy here still
 * advertised the pre-repricing $1.50 / $5 and a Founder offer that is no longer
 * for sale, which is exactly the kind of stale price Google surfaces in a rich
 * result long after the page itself is fixed.
 */
const pricing = getPricingTiers();

// Generate hreflang URLs for all languages
const baseUrl = Astro.site?.toString() || 'https://www.translitpro.com';
const hreflangs = languages.map(lang => ({
  lang: lang.code,
  url: lang.code === 'en' ? baseUrl : `${baseUrl}${lang.code}/`
}));
---

<!DOCTYPE html>
<html lang={currentLang} dir={langDir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
	  
	  <!--
	    Optional UI language override via query param.
	    Example: /?lang=ru or /?lang=ru#features
	    Redirects to the corresponding localized route (e.g. /ru/) while preserving hash.
	  -->
	  <script is:inline define:vars={{ supportedLangCodes, pageLang: currentLang }}>
	    (() => {
	      const supportedLangs = supportedLangCodes;

	      const url = new URL(window.location.href);
	      const requestedLang = url.searchParams.get('lang');
	      if (!requestedLang) return;
	      if (!supportedLangs.includes(requestedLang)) return;

	      // If the requested language matches the current page language, just clean the URL.
	      if (requestedLang === pageLang) {
	        url.searchParams.delete('lang');
	        const cleaned = url.pathname + (url.search ? url.search : '') + (url.hash ? url.hash : '');
	        if (cleaned !== window.location.pathname + window.location.search + window.location.hash) {
	          window.history.replaceState({}, '', cleaned);
	        }
	        return;
	      }

	      // Build the target localized path (English lives at the root).
	      let targetPath;
		      const pathParts = window.location.pathname.split('/').filter(Boolean);

		      // Check if we're already in a localized route (e.g. /ru/ or /ru/scripts/...)
		      const currentPathLang = supportedLangs.includes(pathParts[0]) ? pathParts[0] : 'en';
		      const relativePath = currentPathLang === 'en' ? pathParts : pathParts.slice(1);

		      if (requestedLang === 'en') {
		        targetPath = '/' + relativePath.join('/');
		      } else {
		        targetPath = `/${requestedLang}/` + relativePath.join('/');
		      }

		      // Ensure trailing slash if it's not a file
		      if (targetPath && !targetPath.endsWith('/') && !targetPath.split('/').pop().includes('.')) {
		        targetPath += '/';
		      }

	      // Preserve any other query parameters, but remove `lang`.
	      url.searchParams.delete('lang');
	      const restQuery = url.searchParams.toString();
	      const targetUrl = targetPath + (restQuery ? `?${restQuery}` : '') + (url.hash || '');

	      window.location.replace(targetUrl);
	    })();
	  </script>
    
    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Alternate Language Links (hreflang) -->
    {hreflangs.map(({ lang, url }) => (
      <link rel="alternate" hreflang={lang} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={baseUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Structured Data for SoftwareApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "TranslitPro",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web",
      "description": "Professional transliteration tool for Russian, Ukrainian, Belarusian, and Bulgarian. Type in Latin letters, get Cyrillic output instantly.",
      "offers": [
        {
          "@type": "Offer",
          "name": "Free",
          "price": String(pricing.free.amount),
          "priceCurrency": "USD"
        },
        {
          "@type": "Offer",
          "name": "Basic",
          "price": String(pricing.basic.amount),
          "priceCurrency": "USD",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "billingDuration": "P1M"
          }
        },
        {
          "@type": "Offer",
          "name": "Pro",
          "price": String(pricing.pro.amount),
          "priceCurrency": "USD",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "billingDuration": "P1M"
          }
        }
      ]
    })} />
  </head>
  <body class="bg-slate-900 text-white antialiased">
    <slot />
  </body>
</html>

