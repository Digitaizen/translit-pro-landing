---
/**
 * English homepage — `https://www.translitpro.com/`.
 *
 * This host is the transliteration product's site. The AI-workspace pitch that
 * briefly lived here moved to `www.notylus.net` (its own repo,
 * `notylus-landing`) when the two products were split, so the root is once
 * again the transliteration page — which is what the domain's existing search
 * traffic is looking for.
 *
 * Keep this in sync with `src/pages/[lang]/index.astro`, which renders the same
 * section order for every other locale.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import FeatureSpotlights from '../components/FeatureSpotlights.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import CallToAction from '../components/CallToAction.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../i18n/utils';

const currentLang = 'en';
const t = getTranslations(currentLang);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  currentLang={currentLang}
>
  <Header currentLang={currentLang} t={t} />
  <main>
    <Hero t={t} currentLang={currentLang} />
    <Features t={t} currentLang={currentLang} />
    <FeatureSpotlights t={t} currentLang={currentLang} />
    <Testimonials t={t} />
    <Pricing t={t} currentLang={currentLang} />
    <FAQ t={t} />
    <CallToAction t={t} currentLang={currentLang} />
  </main>
  <Footer t={t} />
</BaseLayout>
