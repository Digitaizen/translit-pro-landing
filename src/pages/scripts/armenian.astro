---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Features from '../../components/Features.astro';
import Pricing from '../../components/Pricing.astro';
import FAQ from '../../components/FAQ.astro';
import CallToAction from '../../components/CallToAction.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/utils';
import { buildAppUrl } from '../../config';

const currentLang = 'en';
const t = getTranslations(currentLang);

const title = 'Armenian Transliteration Tool — Type Armenian with Your Latin Keyboard';
const description = 'Type Armenian script instantly from your Latin keyboard. TranslitPro converts your keystrokes to Armenian characters in real time — no Armenian keyboard layout required.';

const mappings = [
  { latin: 'b',   armenian: 'բ', example: 'barev → բարև'       },
  { latin: 'gh',  armenian: 'ղ', example: 'ghazar → ղազար'     },
  { latin: 'jh',  armenian: 'ժ', example: 'jham → ժամ'         },
  { latin: 'ch',  armenian: 'չ', example: 'chors → չորս'       },
  { latin: 'sh',  armenian: 'շ', example: 'shurj → շուրջ'      },
  { latin: 'ts',  armenian: 'ց', example: 'tsov → ծով'         },
];

const facts = [
  { icon: '📜', title: 'Created in 405 AD', body: 'The Armenian alphabet was invented by Mesrop Mashtots in 405 AD and has remained largely unchanged ever since.' },
  { icon: '🌍', title: 'Diaspora Communities', body: 'Millions of Armenian speakers worldwide use the script — from Armenia to diaspora communities in Russia, France, and the US.' },
  { icon: '🔤', title: '38 Letters', body: 'The Armenian alphabet has 38 letters, each corresponding to a specific sound in the Armenian language.' },
];
---

<BaseLayout title={title} description={description} currentLang={currentLang}
  canonicalURL="https://www.translitpro.com/scripts/armenian/">
  <Header currentLang={currentLang} t={t} />
  <main>

    <!-- Hero -->
    <section class="relative pt-32 pb-20 sm:pt-40 sm:pb-24 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-indigo-900/20 via-slate-900 to-slate-900"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-indigo-500/20 rounded-full blur-3xl"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center px-4 py-1.5 text-sm font-medium text-indigo-300 bg-indigo-500/10 rounded-full border border-indigo-500/20 mb-6">
          <span class="mr-2">🖥️</span>
          Armenian Transliteration — Hayeren Script
        </div>
        <h1 class="text-[clamp(1.75rem,5vw,3.5rem)] font-bold tracking-tight text-white mb-6">
          Type <span class="text-emerald-400">Armenian</span> with Your<br/>
          <span class="text-indigo-400">Latin Keyboard</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10">
          Type "barev" and get բարև. TranslitPro converts your Latin keystrokes into Armenian
          script in real time — perfect for diaspora communities and language learners.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={buildAppUrl('', currentLang)}
             class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl shadow-lg shadow-indigo-500/25 transition-all">
            Start Free — No Signup
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
          <a href="#how-it-works"
             class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-slate-300 bg-slate-800 hover:bg-slate-700 rounded-xl transition-colors">
            See How It Works
          </a>
        </div>
      </div>
    </section>

    <!-- Facts -->
    <section class="py-12 bg-slate-800/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid sm:grid-cols-3 gap-6 text-center">
          {facts.map(card => (
            <div class="bg-slate-800/50 rounded-2xl border border-slate-700/50 p-6">
              <div class="text-3xl mb-3">{card.icon}</div>
              <h3 class="text-white font-semibold mb-2">{card.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{card.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="py-20 bg-slate-900">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">How Armenian Transliteration Works</h2>
          <p class="text-slate-400 text-lg">Latin inputs and their Armenian script equivalents</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-8 items-start">
          <!-- Mapping table -->
          <div class="bg-slate-800/60 rounded-2xl border border-slate-700/50 overflow-hidden">
            <div class="grid grid-cols-3 text-xs font-semibold text-slate-400 uppercase tracking-wider px-5 py-3 border-b border-slate-700/50">
              <span>You type</span><span class="text-center">→</span><span class="text-right">You get</span>
            </div>
            {mappings.map(m => (
              <div class="grid grid-cols-3 items-center px-5 py-3 border-b border-slate-700/30 last:border-0">
                <code class="font-mono text-indigo-300 text-sm">{m.latin}</code>
                <span class="text-slate-600 text-center">→</span>
                <code class="font-mono text-violet-300 text-sm text-right">{m.armenian}</code>
              </div>
            ))}
          </div>
          <!-- Steps -->
          <div class="space-y-6">
            {[
              { n: '1', title: 'Open TranslitPro', body: 'No installation required. Works in any modern desktop browser.' },
              { n: '2', title: 'Select Armenian', body: 'Choose Armenian from the language list. The full 38-letter alphabet is pre-configured.' },
              { n: '3', title: 'Type phonetically', body: 'Type "Hayastan" and see Հայաստան appear. Special combos like "gh" → ղ and "jh" → ժ are built in.' },
            ].map(step => (
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-300 text-sm font-bold">{step.n}</div>
                <div>
                  <h3 class="text-white font-semibold mb-1">{step.title}</h3>
                  <p class="text-slate-400 text-sm leading-relaxed">{step.body}</p>
                </div>
              </div>
            ))}
            <a href={buildAppUrl('', currentLang)}
               class="inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl transition-colors mt-2">
              Try it free
              <svg class="ml-1.5 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <Features t={t} currentLang={currentLang} />
    <Pricing t={t} currentLang={currentLang} />
    <FAQ t={t} />
    <CallToAction t={t} currentLang={currentLang} />
  </main>
  <Footer t={t} />
</BaseLayout>
