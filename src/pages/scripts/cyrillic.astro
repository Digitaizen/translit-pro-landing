---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Features from '../../components/Features.astro';
import Pricing from '../../components/Pricing.astro';
import FAQ from '../../components/FAQ.astro';
import CallToAction from '../../components/CallToAction.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/utils';
import { buildAppUrl } from '../../config';

const currentLang = 'en';
const t = getTranslations(currentLang);

const title = 'Cyrillic Transliteration Tool — Type Russian, Ukrainian & More with Latin Keys';
const description = 'Type Cyrillic instantly from your Latin keyboard. Supports Russian, Ukrainian, Belarusian, Bulgarian, Serbian, Kazakh, Tajik, and Rusyn. No keyboard switching needed.';

const languages = [
  { name: 'Russian',     native: 'Русский',     latin: 'Privet, kak dela?',        cyrillic: 'Привет, как дела?',     color: 'text-indigo-300' },
  { name: 'Ukrainian',   native: 'Українська',  latin: 'Pryvit, yak spravy?',       cyrillic: 'Привіт, як справи?',    color: 'text-blue-300'   },
  { name: 'Belarusian',  native: 'Беларуская',  latin: 'Vitaju, jak spravy?',       cyrillic: 'Вітаю, як справы?',     color: 'text-cyan-300'   },
  { name: 'Bulgarian',   native: 'Български',   latin: 'Zdravejte, kak ste?',       cyrillic: 'Здравейте, как сте?',   color: 'text-purple-300' },
  { name: 'Serbian',     native: 'Српски',      latin: 'Zdravo, kako si?',          cyrillic: 'Здраво, како си?',      color: 'text-fuchsia-300'},
  { name: 'Kazakh',      native: 'Қазақша',     latin: "Salem, k'alajsyz ba?",      cyrillic: 'Салем, қалайсыз ба?',   color: 'text-teal-300'   },
  { name: 'Tajik',       native: 'Тоҷикӣ',      latin: 'Salom, chjtavr h\'asti?',   cyrillic: 'Салом, чӣтавр ҳастӣ?',  color: 'text-orange-300' },
  { name: 'Rusyn',       native: 'Русиньскый',  latin: 'Zdorov, yak sya mash?',     cyrillic: 'Здоров, як ся маш?',    color: 'text-rose-300'   },
];

const mappings = [
  { latin: 'sh',   cyrillic: 'ш',  example: 'sha → ша'   },
  { latin: 'zh',   cyrillic: 'ж',  example: 'zhizn → жизнь' },
  { latin: 'ch',   cyrillic: 'ч',  example: 'chest → честь' },
  { latin: 'ya',   cyrillic: 'я',  example: 'ya → я'      },
  { latin: 'yu',   cyrillic: 'ю',  example: 'yug → юг'    },
  { latin: 'ts',   cyrillic: 'ц',  example: 'tsar → царь' },
];
---

<BaseLayout title={title} description={description} currentLang={currentLang}>
  <Header currentLang={currentLang} t={t} />
  <main>

    <!-- Hero -->
    <section class="relative pt-32 pb-20 sm:pt-40 sm:pb-24 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-indigo-900/20 via-slate-900 to-slate-900"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-indigo-500/20 rounded-full blur-3xl"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center px-4 py-1.5 text-sm font-medium text-indigo-300 bg-indigo-500/10 rounded-full border border-indigo-500/20 mb-6">
          <span class="mr-2">🖥️</span>
          Cyrillic Transliteration — 8 Languages
        </div>
        <h1 class="text-[clamp(1.75rem,5vw,3.5rem)] font-bold tracking-tight text-white mb-6">
          Type <span class="text-emerald-400">Cyrillic</span> with Your<br/>
          <span class="text-indigo-400">Latin Keyboard</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10">
          Just type the way you already know — TranslitPro converts your Latin keystrokes into
          Cyrillic in real time. Russian, Ukrainian, Bulgarian, and 5 more scripts. No layout switching, no memorizing.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={buildAppUrl('', currentLang)}
             class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl shadow-lg shadow-indigo-500/25 transition-all">
            Start Free — No Signup
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
          <a href="#how-it-works"
             class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-slate-300 bg-slate-800 hover:bg-slate-700 rounded-xl transition-colors">
            See How It Works
          </a>
        </div>
      </div>
    </section>

    <!-- Supported Languages -->
    <section class="py-20 bg-slate-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">8 Cyrillic Languages, Built In</h2>
          <p class="text-slate-400 text-lg max-w-2xl mx-auto">
            All Cyrillic scripts are pre-configured. Open the app and start typing — no setup needed.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {languages.map(lang => (
            <div class="bg-slate-800/50 rounded-2xl border border-slate-700/50 p-5">
              <div class="flex items-baseline justify-between mb-3">
                <span class="font-semibold text-white">{lang.name}</span>
                <span class="text-sm text-slate-500">{lang.native}</span>
              </div>
              <p class="text-xs text-slate-500 font-mono mb-1">{lang.latin}</p>
              <p class={`font-mono text-sm ${lang.color}`}>{lang.cyrillic}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="py-20 bg-slate-800/30">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">How Cyrillic Transliteration Works</h2>
          <p class="text-slate-400 text-lg">Common Latin combinations and their Cyrillic equivalents</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-8 items-start">
          <!-- Mapping table -->
          <div class="bg-slate-800/60 rounded-2xl border border-slate-700/50 overflow-hidden">
            <div class="grid grid-cols-3 text-xs font-semibold text-slate-400 uppercase tracking-wider px-5 py-3 border-b border-slate-700/50">
              <span>You type</span><span class="text-center">→</span><span class="text-right">You get</span>
            </div>
            {mappings.map(m => (
              <div class="grid grid-cols-3 items-center px-5 py-3 border-b border-slate-700/30 last:border-0">
                <code class="font-mono text-indigo-300 text-sm">{m.latin}</code>
                <span class="text-slate-600 text-center">→</span>
                <code class="font-mono text-emerald-300 text-sm text-right">{m.cyrillic}</code>
              </div>
            ))}
          </div>
          <!-- Steps -->
          <div class="space-y-6">
            {[
              { n: '1', title: 'Open TranslitPro', body: 'No installation required. Works in any modern desktop browser.' },
              { n: '2', title: 'Select your Cyrillic language', body: 'Russian, Ukrainian, Bulgarian, and more are pre-loaded. Switch between them any time.' },
              { n: '3', title: 'Just type', body: 'TranslitPro converts your Latin keystrokes into the correct Cyrillic characters as you type.' },
            ].map(step => (
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-300 text-sm font-bold">{step.n}</div>
                <div>
                  <h3 class="text-white font-semibold mb-1">{step.title}</h3>
                  <p class="text-slate-400 text-sm leading-relaxed">{step.body}</p>
                </div>
              </div>
            ))}
            <a href={buildAppUrl('', currentLang)}
               class="inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl transition-colors mt-2">
              Try it free
              <svg class="ml-1.5 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <Features t={t} currentLang={currentLang} />
    <Pricing t={t} currentLang={currentLang} />
    <FAQ t={t} />
    <CallToAction t={t} currentLang={currentLang} />
  </main>
  <Footer t={t} />
</BaseLayout>
