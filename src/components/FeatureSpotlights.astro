---
/**
 * Feature Spotlights — three narrative sections that show the product in action.
 * Each section pairs copy with a CSS mockup visual (placeholder until real screenshots/GIFs arrive).
 *
 * To swap a mockup for a real visual:
 *   1. Put your file in /public/screenshots/ (images) or /public/videos/ (MP4/WebM)
 *   2. Replace the <!-- VISUAL PLACEHOLDER --> block with:
 *      <img src="/screenshots/your-file.png" alt="..." class="rounded-2xl w-full shadow-2xl" />
 *      or for video:
 *      <video src="/videos/your-file.mp4" autoplay loop muted playsinline class="rounded-2xl w-full shadow-2xl" />
 *
 * Renders only when t.featureSpotlights exists (English until i18n sync runs).
 */

interface Props {
  t: any;
  currentLang?: string;
}

const { t } = Astro.props;
const s = t.featureSpotlights ?? null;
---

<!-- ── Section 1: Stop Switching Keyboards ──────────────────────────── -->
{s && (
  <section class="py-20 sm:py-32 bg-slate-900 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Text -->
        <div>
          <p class="text-sm font-semibold text-indigo-400 uppercase tracking-wider mb-3">{s.keyboard.eyebrow}</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">{s.keyboard.headline}</h2>
          <p class="text-lg text-slate-400 leading-relaxed">{s.keyboard.copy}</p>
        </div>

        <!-- VISUAL PLACEHOLDER: before/after keyboard comparison -->
        <div class="relative">
          <div class="absolute -inset-4 bg-indigo-500/5 rounded-3xl blur-2xl pointer-events-none"></div>
          <div class="relative rounded-2xl overflow-hidden border border-slate-700/50 shadow-2xl">
            <!-- Fake title bar -->
            <div class="bg-slate-800 px-4 py-3 flex items-center gap-2 border-b border-slate-700/50">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/50"></div>
              </div>
              <div class="text-xs text-slate-500 font-mono ml-2">System Preferences → Keyboard → Input Sources</div>
            </div>
            <!-- Split: before / after -->
            <div class="grid grid-cols-2 divide-x divide-slate-700/50">
              <!-- Before -->
              <div class="bg-slate-900 p-5">
                <div class="text-xs text-red-400/80 font-medium mb-3">Without TranslitPro</div>
                <div class="space-y-1.5">
                  <div class="flex items-center gap-2 px-2 py-1 rounded bg-indigo-600/20 text-slate-300 text-xs">
                    <span>🇺🇸</span><span>English (US)</span>
                  </div>
                  <div class="flex items-center gap-2 px-2 py-1 rounded text-slate-500 text-xs">
                    <span>🇷🇺</span><span>Russian Phonetic</span>
                  </div>
                  <div class="flex items-center gap-2 px-2 py-1 rounded text-slate-500 text-xs">
                    <span>🇺🇦</span><span>Ukrainian</span>
                  </div>
                  <div class="flex items-center gap-2 px-2 py-1 rounded text-slate-500 text-xs">
                    <span>🇬🇷</span><span>Greek (Polytonic)</span>
                  </div>
                  <div class="flex items-center gap-2 px-2 py-1 rounded text-slate-500 text-xs">
                    <span>🇮🇱</span><span>Hebrew</span>
                  </div>
                </div>
                <div class="mt-4 text-xs text-red-400/60">↕ Switch for every language change</div>
              </div>
              <!-- After -->
              <div class="bg-slate-900 p-5">
                <div class="text-xs text-green-400/80 font-medium mb-3">With TranslitPro</div>
                <div class="space-y-2.5">
                  <div class="font-mono text-xs">
                    <span class="text-slate-500">privet</span>
                    <span class="text-slate-600 mx-1">→</span>
                    <span class="text-indigo-300">Привет</span>
                  </div>
                  <div class="font-mono text-xs">
                    <span class="text-slate-500">shlom</span>
                    <span class="text-slate-600 mx-1">→</span>
                    <span class="text-emerald-300">שלום</span>
                  </div>
                  <div class="font-mono text-xs">
                    <span class="text-slate-500">geia sas</span>
                    <span class="text-slate-600 mx-1">→</span>
                    <span class="text-sky-300">Γεια σας</span>
                  </div>
                  <div class="font-mono text-xs">
                    <span class="text-slate-500">gamarjoba</span>
                    <span class="text-slate-600 mx-1">→</span>
                    <span class="text-amber-300">გამარჯობა</span>
                  </div>
                  <div class="font-mono text-xs">
                    <span class="text-slate-500">barev</span>
                    <span class="text-slate-600 mx-1">→</span>
                    <span class="text-violet-300">Բարև</span>
                  </div>
                </div>
                <div class="mt-4 text-xs text-green-400/60">✓ One keyboard. Every language.</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
)}

<!-- ── Section 2: Bookmarklet ────────────────────────────────────────── -->
{s && (
  <section class="py-20 sm:py-32 bg-slate-800/20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- VISUAL PLACEHOLDER: browser with social media input (LEFT on desktop) -->
        <div class="relative order-2 lg:order-1">
          <div class="absolute -inset-4 bg-cyan-500/5 rounded-3xl blur-2xl pointer-events-none"></div>
          <div class="relative rounded-2xl overflow-hidden border border-slate-700/50 shadow-2xl">
            <!-- Browser chrome -->
            <div class="bg-slate-800 px-4 py-2.5 flex items-center gap-3 border-b border-slate-700/50">
              <div class="flex gap-1.5 flex-shrink-0">
                <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/50"></div>
              </div>
              <div class="flex-1 bg-slate-700/60 rounded px-3 py-1 text-xs text-slate-400 font-mono">x.com</div>
            </div>
            <!-- Page content -->
            <div class="bg-slate-900 p-5">
              <!-- Tab nav -->
              <div class="flex gap-6 mb-4 border-b border-slate-800 pb-2">
                <span class="text-xs text-white font-bold border-b-2 border-indigo-500 pb-1.5">For you</span>
                <span class="text-xs text-slate-500">Following</span>
              </div>
              <!-- Compose box -->
              <div class="bg-slate-800/60 rounded-xl p-4 border border-slate-700/50">
                <div class="flex gap-3">
                  <div class="w-9 h-9 rounded-full bg-indigo-500/40 flex-shrink-0"></div>
                  <div class="flex-1">
                    <div class="text-sm text-white mb-1.5" translate="no">Привет! Как дела у всех?</div>
                    <div class="text-xs text-slate-600 font-mono">← typed in Latin · shown in Russian</div>
                  </div>
                </div>
                <div class="mt-3 flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                    <span class="text-xs text-cyan-400/80 font-medium">TranslitPro active</span>
                  </div>
                  <div class="bg-indigo-600 rounded-full px-4 py-1 text-xs text-white font-semibold">Post</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Text (RIGHT on desktop) -->
        <div class="order-1 lg:order-2">
          <p class="text-sm font-semibold text-cyan-400 uppercase tracking-wider mb-3">{s.bookmarklet.eyebrow}</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{s.bookmarklet.headline}</h2>
          <p class="text-lg text-slate-300 font-medium mb-4">{s.bookmarklet.subheadline}</p>
          <p class="text-lg text-slate-400 leading-relaxed mb-6">{s.bookmarklet.copy}</p>
          <p class="text-sm text-slate-500 border-l-2 border-slate-700 pl-3 leading-relaxed">{s.bookmarklet.note}</p>
        </div>

      </div>
    </div>
  </section>
)}

<!-- ── Section 3: Editor ──────────────────────────────────────────────── -->
{s && (
  <section class="py-20 sm:py-32 bg-slate-900 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Text — centered above the image -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <p class="text-sm font-semibold text-indigo-400 uppercase tracking-wider mb-3">{s.editor.eyebrow}</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">{s.editor.headline}</h2>
        <p class="text-lg text-slate-400 leading-relaxed">{s.editor.copy}</p>
        {s.editor.copy2 && <p class="text-lg text-slate-400 leading-relaxed">{s.editor.copy2}</p>}
        {s.editor.tagline && <p class="text-lg text-slate-400 leading-relaxed">{s.editor.tagline}</p>}
      </div>

      <!-- Full-width image, clickable to open lightbox -->
      <div class="relative group cursor-zoom-in" id="editor-lightbox-trigger">
        <div class="absolute -inset-4 bg-indigo-500/5 rounded-3xl blur-2xl pointer-events-none"></div>
        <img
          src="/screenshots/TranslitPro_RichTextEditor.png"
          alt="TranslitPro Rich Text Editor"
          class="relative rounded-2xl w-full shadow-2xl border border-slate-700/50 transition-opacity group-hover:opacity-90"
        />
        <!-- Click-to-zoom hint -->
        <div class="absolute bottom-4 right-4 flex items-center gap-1.5 bg-slate-900/80 backdrop-blur-sm text-slate-300 text-xs font-medium px-3 py-1.5 rounded-full border border-slate-700/50 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0zm0 0l4 4" />
          </svg>
          Click to enlarge
        </div>
      </div>

    </div>
  </section>

  <!-- Lightbox overlay -->
  <div
    id="editor-lightbox"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-sm p-4 hidden"
    role="dialog"
    aria-modal="true"
    aria-label="TranslitPro Rich Text Editor — full view"
  >
    <!-- Close button -->
    <button
      id="editor-lightbox-close"
      class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors"
      aria-label="Close"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <!-- Full image -->
    <img
      src="/screenshots/TranslitPro_RichTextEditor.png"
      alt="TranslitPro Rich Text Editor — full view"
      class="max-w-full max-h-full rounded-xl shadow-2xl object-contain cursor-zoom-out"
      id="editor-lightbox-img"
    />
  </div>

  <script>
    const trigger = document.getElementById('editor-lightbox-trigger');
    const lightbox = document.getElementById('editor-lightbox');
    const closeBtn = document.getElementById('editor-lightbox-close');

    trigger?.addEventListener('click', () => lightbox?.classList.remove('hidden'));
    closeBtn?.addEventListener('click', () => lightbox?.classList.add('hidden'));
    lightbox?.addEventListener('click', () => lightbox.classList.add('hidden'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') lightbox?.classList.add('hidden');
    });
  </script>
)}
