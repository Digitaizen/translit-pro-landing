---
/**
 * Features section component - showcases key product features.
 * Uses a grid layout with icons and descriptions.
 */

interface Props {
  t: any;
  currentLang?: string;
}

const { t, currentLang = 'en' } = Astro.props;

/**
 * Build app URL with optional language parameter.
 * Only appends lang param if not English (default).
 */
const buildAppUrl = (path: string = '') => {
  const base = `https://app.translitpro.com${path}`;
  return currentLang !== 'en' ? `${base}?lang=${currentLang}` : base;
};

const features = [
  {
    icon: '⌨️',
    ...t.features.typeNaturally
  },
  {
    icon: '🌍',
    ...t.features.languages
  },
  {
    icon: '➕',
    ...t.features.addLanguage
  },
  {
    icon: '🔖',
    ...t.features.bookmarklet
  },
  {
    icon: '🌐',
    ...t.features.translation
  },
  {
    icon: '🤖',
    ...t.features.aiSpellcheck
  },
  {
    icon: '📝',
    ...t.features.editor
  },
  {
    icon: '📄',
    ...t.features.export
  }
];
---

<section id="features" class="py-20 sm:py-32 bg-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        {t.features.title}
      </h2>
      <p class="text-lg text-slate-400">
        {t.features.subtitle}
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {features.map((feature) => (
        <div class="group p-6 bg-slate-800/50 rounded-2xl border border-slate-700/50 hover:border-indigo-500/50 transition-colors">
          <div class="text-4xl mb-4">{feature.icon}</div>
          <h3 class="text-lg font-semibold text-white mb-2">{feature.title}</h3>
          <p class="text-slate-400 text-sm leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-16 text-center">
      <a
        href={buildAppUrl()}
        class="inline-flex items-center px-6 py-3 text-sm font-semibold text-indigo-400 hover:text-indigo-500 transition-colors"
      >
        {t.features.exploreAll}
        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>

