---
/**
 * Final Call-to-Action section — displayed after FAQ, right before the footer.
 * Renders only when t.cta exists (English until i18n sync runs).
 */

import { buildAppUrl } from '../config';

interface Props {
  t: any;
  currentLang?: string;
}

const { t, currentLang = 'en' } = Astro.props;
const s = t.cta ?? null;
---

{s && (
  <section class="py-20 sm:py-28 relative overflow-hidden">

    <!-- Background -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900 via-indigo-950/40 to-slate-900"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <h2 class="text-3xl sm:text-5xl font-bold text-white mb-4">{s.headline}</h2>
      <p class="text-lg sm:text-xl text-slate-400 mb-10">{s.subheadline}</p>

      <a
        href={buildAppUrl('', currentLang)}
        class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl shadow-lg shadow-indigo-500/25 transition-all hover:shadow-indigo-500/40"
      >
        {s.button}
        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <!-- Trust badges -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-slate-500">
        {[s.badge1, s.badge2, s.badge3].map((badge) => (
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>{badge}</span>
          </div>
        ))}
      </div>

    </div>
  </section>
)}
