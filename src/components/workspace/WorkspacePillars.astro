---
const pillars = [
  {
    eyebrow: 'Multilingual writing',
    title: 'Type the way you think',
    body: 'Use your Latin keyboard to write in Cyrillic, Hebrew, Greek, Georgian, Armenian, and more — without memorizing layouts or switching OS settings.',
    points: ['Real-time transliteration', '13+ built-in scripts', 'Custom language systems'],
    color: 'text-emerald-300 bg-emerald-500/10 border-emerald-500/20',
  },
  {
    eyebrow: 'AI assistance',
    title: 'Polish multilingual drafts',
    body: 'Correct spelling, clean up grammar, normalize mixed-language text, translate passages, and keep your meaning intact across scripts.',
    points: ['AI corrections', 'Translation workflows', 'Mixed-language cleanup'],
    color: 'text-indigo-300 bg-indigo-500/10 border-indigo-500/20',
  },
  {
    eyebrow: 'Your workspace',
    title: 'Keep every draft organized',
    body: 'Save documents in the cloud, organize your writing, export to the formats you need, and bring your assistant to most websites with the bookmarklet.',
    points: ['Cloud documents', 'DOCX, PDF, TXT exports', 'Write on most websites'],
    color: 'text-cyan-300 bg-cyan-500/10 border-cyan-500/20',
  },
];
---

<section id="features" class="py-20 sm:py-32 bg-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="text-sm font-semibold text-indigo-400 uppercase tracking-wider mb-3">One workspace, three superpowers</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Built for multilingual people, not single-language workflows</h2>
      <p class="text-lg text-slate-400">Transliteration is the instant hook. AI and workspace tools turn it into a daily writing system.</p>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
      {pillars.map((pillar) => (
        <article class="relative p-7 rounded-3xl border border-slate-700/60 bg-slate-800/45 hover:border-indigo-500/40 transition-colors overflow-hidden">
          <div class="absolute top-0 right-0 w-44 h-44 bg-indigo-500/5 rounded-full blur-3xl"></div>
          <div class={`relative inline-flex px-3 py-1 rounded-full text-xs font-semibold border mb-5 ${pillar.color}`}>
            {pillar.eyebrow}
          </div>
          <h3 class="relative text-2xl font-bold text-white mb-3">{pillar.title}</h3>
          <p class="relative text-slate-400 leading-relaxed mb-6">{pillar.body}</p>
          <ul class="relative space-y-3">
            {pillar.points.map((point) => (
              <li class="flex items-center gap-3 text-sm text-slate-300">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                {point}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
