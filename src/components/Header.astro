---
/**
 * Header/Navigation component for the landing page.
 * Includes logo, navigation links, language dropdown, and CTA button.
 */

import LanguageDropdown from './LanguageDropdown.astro';
import { buildAppUrl, NOTYLUS_SITE_URL } from '../config';

interface Props {
  currentLang?: string;
  t: any;
}

const { currentLang = 'en', t } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50">
  <!--
    Reconstruction / Notylus move notice — visibility is DB-backed
    (public.app_status_banner.translitpro_show, read anonymously below), so it
    can be flipped without a deploy. Starts hidden; the script un-hides it
    once the flag comes back true and the visitor hasn't dismissed it this
    session. The notice text links to the Notylus site (it already names
    Notylus in all 13 locales), with a separate dismiss control beside it so
    dismissing doesn't also navigate.
  -->
  <div id="status-banner" class="hidden bg-amber-500 text-slate-900 text-center py-1.5 px-4 text-sm font-medium leading-snug">
    <a href={NOTYLUS_SITE_URL} class="align-middle hover:underline">🚧 {t.nav.underConstruction}</a>
    <button id="status-banner-dismiss" aria-label="Dismiss" class="ml-2 align-middle text-slate-900/70 hover:text-slate-900 font-bold">✕</button>
  </div>
  <div class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800">
  <nav class="w-full px-4 sm:px-6 lg:px-8">
    <div class="relative flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <img src="/logo.png" alt="TranslitPro Logo" class="w-12 h-12" />
        <img src="/title.png" alt="TranslitPro" class="h-6" />
      </a>

      <!-- Desktop Navigation - Absolutely centered -->
      <div class="hidden md:flex items-center space-x-8 absolute left-1/2 -translate-x-1/2">
        <a href="#features" class="text-slate-300 hover:text-white transition-colors">
          {t.nav.features}
        </a>
        <a href="#pricing" class="text-slate-300 hover:text-white transition-colors">
          {t.nav.pricing}
        </a>
        <a href="#faq" class="text-slate-300 hover:text-white transition-colors">
          {t.nav.faq}
        </a>
      </div>

      <!-- CTA Buttons & Language Dropdown -->
      <div class="flex items-center gap-3">
        <!-- Theme Toggle (invisible - site not themeable yet) -->
        <button
          class="p-2 rounded-lg transition-colors invisible"
          aria-label="Toggle theme (disabled)"
          aria-hidden="true"
          disabled
        >
          <!-- Moon icon (dark mode indicator) -->
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>

        <LanguageDropdown currentLang={currentLang} t={t} />

        <!-- Sign In / Back to App (swapped client-side based on tp_logged_in cookie) -->
        <a
          id="header-auth-btn"
          href={buildAppUrl('/login', currentLang)}
          data-app-url={buildAppUrl('/', currentLang)}
          data-back-label={t.nav.backToApp}
          class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-lg hover:bg-slate-800 transition-colors"
        >
          <!-- LogIn icon (shown when logged out) -->
          <svg id="header-icon-signin" class="w-5 h-5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
            <polyline points="10 17 15 12 10 7" />
            <line x1="15" y1="12" x2="3" y2="12" />
          </svg>
          <!-- Back-to-app icon (hidden by default, shown when logged in) -->
          <svg id="header-icon-back" class="w-5 h-5 text-slate-300 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span id="header-auth-label" class="text-sm text-slate-300">{t.nav.signIn}</span>
        </a>

        <!-- Start Now (Start Trial) — hidden for logged-in users -->
        <a
          id="header-start-now-btn"
          href={buildAppUrl('/trial', currentLang)}
          class="flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors text-sm font-medium text-white"
        >
          <!-- Play icon -->
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <polygon points="6 3 20 12 6 21 6 3" fill="currentColor" stroke="currentColor" />
          </svg>
          <span>{t.nav.startNow}</span>
        </a>
      </div>
      
      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 text-slate-400 hover:text-white"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
    
    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col space-y-4 pt-4 border-t border-slate-800">
        <a href="#features" class="text-slate-300 hover:text-white transition-colors">
          {t.nav.features}
        </a>
        <a href="#pricing" class="text-slate-300 hover:text-white transition-colors">
          {t.nav.pricing}
        </a>
        <a href="#faq" class="text-slate-300 hover:text-white transition-colors">
          {t.nav.faq}
        </a>
      </div>
    </div>
  </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Swap "Sign In" → "Back to App" if the user is already logged into the app
  (function () {
    const isLoggedIn = document.cookie.split(';').some(c => c.trim().startsWith('tp_logged_in='));
    if (!isLoggedIn) return;

    const btn = document.getElementById('header-auth-btn') as HTMLAnchorElement | null;
    const label = document.getElementById('header-auth-label');
    const iconSignIn = document.getElementById('header-icon-signin');
    const iconBack = document.getElementById('header-icon-back');

    if (btn) btn.href = btn.dataset.appUrl ?? btn.href;
    if (label) label.textContent = btn?.dataset.backLabel ?? label.textContent;
    iconSignIn?.classList.add('hidden');
    iconBack?.classList.remove('hidden');

    document.getElementById('header-start-now-btn')?.classList.add('hidden');
  })();

  // Reconstruction / Beta notice — reads public.app_status_banner directly
  // over PostgREST (anon key, RLS-gated public read). Fails closed (banner
  // stays hidden) on any missing config, network error, or non-2xx response.
  (async function () {
    const SESSION_KEY = 'tp_status_banner_dismissed';
    const banner = document.getElementById('status-banner');
    const dismissBtn = document.getElementById('status-banner-dismiss');
    if (!banner) return;

    dismissBtn?.addEventListener('click', () => {
      sessionStorage.setItem(SESSION_KEY, 'true');
      banner.classList.add('hidden');
    });

    if (sessionStorage.getItem(SESSION_KEY) === 'true') return;

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    if (!supabaseUrl || !supabaseAnonKey) return;

    try {
      const res = await fetch(
        `${supabaseUrl}/rest/v1/app_status_banner?select=translitpro_show&id=eq.true`,
        { headers: { apikey: supabaseAnonKey, Authorization: `Bearer ${supabaseAnonKey}` } }
      );
      if (!res.ok) return;
      const rows = await res.json();
      if (rows?.[0]?.translitpro_show) {
        banner.classList.remove('hidden');
      }
    } catch {
      // Network/DB error — leave the banner hidden.
    }
  })();
</script>

