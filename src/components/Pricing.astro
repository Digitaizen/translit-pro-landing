---
/**
 * Product pricing for the post-split TranslitPro surface.
 * TranslitPro has two commercial bands: Free and TranslitPro Plus.
 */
import { buildAppUrl, NOTYLUS_SITE_URL } from '../config';
import { getPricingTiers } from '../features/pricing/getPricingTiers';

interface Props { t: any; currentLang?: string; }
const { t, currentLang = 'en' } = Astro.props;
const pricing = getPricingTiers();

const isEnglish = currentLang === 'en';
const plusSearch = t.pricing.pro.features[isEnglish ? 6 : 5];
const plusExports = t.pricing.pro.features[isEnglish ? 7 : 6];
const plusTheme = t.pricing.pro.features[isEnglish ? 8 : 7];
const noAds = t.pricing.basic.features[isEnglish ? 11 : 10];
const plusEditorTools: Record<string, string> = {
  en: 'More editor tools', ru: 'Больше инструментов редактора', uk: 'Більше інструментів редактора',
  be: 'Больш інструментаў рэдактара', bg: 'Още инструменти за редактиране', he: 'כלי עריכה נוספים',
  hy: 'Խմբագրիչի ավելի շատ գործիքներ', ka: 'რედაქტორის მეტი ხელსაწყო', el: 'Περισσότερα εργαλεία επεξεργασίας',
  lt: 'Daugiau redagavimo įrankių', tg: 'Абзорҳои бештари муҳаррир', rue: 'Веце редакторьскых інструментів',
  sr: 'Više alata za uređivanje', kk: 'Көбірек өңдеу құралдары',
};
const anonymousFeatures = [
  t.pricing.free.anonymous.features[0],
  t.pricing.free.anonymous.features[1],
  t.pricing.free.anonymous.features[3],
  t.features['export'].title + ': TXT, PDF, DOCX, .notylus',
  t.featureSpotlights.bookmarklet.headline,
  t.features.editor.title,
];
const accountFeatures = [
  t.pricing.free.registered.features[0],
  t.pricing.basic.features[1],
  t.pricing.basic.features[2],
  t.pricing.basic.features[3],
];
const plusFeatures = [plusEditorTools[currentLang] ?? plusEditorTools.en, plusSearch, plusExports, plusTheme, noAds];
---

<section id="pricing" class="py-20 sm:py-32 bg-slate-950">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{t.pricing.title}</h2>
      <p class="text-lg text-slate-400">{t.pricing.subtitle}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 lg:gap-8 items-stretch">
      <article class="flex flex-col p-6 sm:p-8 rounded-2xl border bg-slate-800/50 border-slate-700">
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-white mb-2">{t.pricing.free.name}</h3>
          <p class="text-slate-400">{t.pricing.free.anonymous.tagline}</p>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="text-sm text-slate-400">{pricing.currencySymbol}</span>
            <span class="text-5xl font-bold text-white">{pricing.free.amount}</span>
            <span class="text-slate-400">{t.pricing.free.anonymous.period}</span>
          </div>
        </div>

        <div class="flex-1 space-y-6 mb-8">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-indigo-300 mb-3">{t.pricing.tabs.anonymous}</p>
            <ul class="space-y-3">
              {anonymousFeatures.map((feature: string) => (
                <li class="flex items-start gap-2 text-sm text-slate-300"><span class="mt-0.5 text-emerald-400" aria-hidden="true">✓</span><span>{feature}</span></li>
              ))}
            </ul>
          </div>
          <div class="pt-5 border-t border-slate-700/70">
            <p class="text-xs font-semibold uppercase tracking-wider text-indigo-300 mb-3">{t.pricing.free.registered.cta}</p>
            <ul class="space-y-3">
              {accountFeatures.map((feature: string) => (
                <li class="flex items-start gap-2 text-sm text-slate-300"><span class="mt-0.5 text-emerald-400" aria-hidden="true">✓</span><span>{feature}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <a href={buildAppUrl('', currentLang)} class="block w-full py-3 px-4 text-center text-sm font-semibold rounded-lg bg-slate-700 text-white hover:bg-slate-600 transition-colors">{t.pricing.free.anonymous.cta}</a>
      </article>

      <article class="relative flex flex-col p-6 sm:p-8 rounded-2xl border bg-indigo-950/35 border-indigo-500/60 shadow-xl shadow-indigo-950/30">
        <div class="absolute -top-3 right-6 px-3 py-1 rounded-full bg-indigo-500 text-xs font-bold text-white">PLUS</div>
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-white mb-2">TranslitPro Plus</h3>
          <p class="text-slate-400">{t.pricing.basic.tagline}</p>
        </div>
        <div data-pricing-tabs-root data-default-tab="annual" class="flex flex-col flex-1">
          <div class="inline-flex self-start items-center gap-1 p-1 rounded-xl bg-slate-900/70 border border-slate-700/60 mb-5" role="tablist">
            <button type="button" data-tab="monthly" role="tab" aria-selected="false" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-300 hover:text-white">{t.pricing.tabs.monthly}</button>
            <button type="button" data-tab="annual" role="tab" aria-selected="true" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-indigo-600 text-white">{t.pricing.tabs.annual}</button>
          </div>
          <div data-tab-panels class="mb-7">
            <div data-panel="monthly" class="hidden"><div class="flex items-baseline gap-1"><span class="text-sm text-slate-400">{pricing.currencySymbol}</span><span class="text-5xl font-bold text-white">{pricing.plus.amount}</span><span class="text-slate-400">{t.pricing.basic.period}</span></div></div>
            <div data-panel="annual"><div class="flex items-baseline gap-1"><span class="text-sm text-slate-400">{pricing.currencySymbol}</span><span class="text-5xl font-bold text-white">{pricing.plus.annualAmount}</span><span class="text-slate-400">{t.pricing.basic.periodAnnual}</span></div><p class="mt-1 text-sm text-emerald-300">{t.pricing.saveLabel} {pricing.currencySymbol}{pricing.plus.annualSavingsAmount}</p></div>
          </div>
          <ul class="flex-1 space-y-3 mb-8">
            {plusFeatures.map((feature: string) => (
              <li class="flex items-start gap-2 text-sm text-slate-300"><span class="mt-0.5 text-emerald-400" aria-hidden="true">✓</span><span>{feature}</span></li>
            ))}
          </ul>
          <a href={buildAppUrl('', currentLang)} class="block w-full py-3 px-4 text-center text-sm font-semibold rounded-lg bg-indigo-600 text-white hover:bg-indigo-500 transition-colors">{t.nav.startNow} — TranslitPro Plus</a>
        </div>
      </article>
    </div>

    <aside class="mt-10 rounded-2xl border border-slate-700/70 bg-slate-900/70 p-6 sm:p-8 text-center">
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">Notylus</h3>
      <p class="text-slate-400 max-w-2xl mx-auto mb-5">{t.nav.underConstruction}</p>
      <a href={NOTYLUS_SITE_URL} class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/10 transition-colors">Notylus <span class="ml-2" aria-hidden="true">→</span></a>
    </aside>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-pricing-tabs-root]').forEach(root => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const activate = (tab: string) => {
      buttons.forEach(button => {
        const active = button.dataset.tab === tab;
        button.setAttribute('aria-selected', String(active));
        button.classList.toggle('bg-indigo-600', active);
        button.classList.toggle('text-white', active);
        button.classList.toggle('text-slate-300', !active);
      });
      panels.forEach(panel => panel.classList.toggle('hidden', panel.dataset.panel !== tab));
    };
    buttons.forEach(button => button.addEventListener('click', () => activate(button.dataset.tab ?? 'annual')));
  });
</script>
