---
/**
 * Hero section component - the main above-the-fold content.
 * Includes headline, subheadline, CTAs, and a visual demo.
 */

import { buildAppUrl } from '../config';

interface Props {
  t: any;
  currentLang?: string;
}

const { t, currentLang = 'en' } = Astro.props;

if (!t || !t.hero) {
  throw new Error('Hero component requires translations prop (t) with hero section');
}
---

<section class="relative pt-32 pb-20 sm:pt-40 sm:pb-24 overflow-hidden">
  <!-- Background Gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-indigo-900/20 via-slate-900 to-slate-900"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-indigo-500/20 rounded-full blur-3xl"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Badge - centered -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center px-4 py-1.5 text-sm font-medium text-indigo-300 bg-indigo-500/10 rounded-full border border-indigo-500/20">
        <span class="mr-2">🖥️</span>
        {t.hero.badge}
      </div>
    </div>

    <!-- Headline - full width, centered, responsive font scaling -->
    <h1 class="text-[clamp(1.75rem,5vw,3.75rem)] font-bold tracking-tight mb-6 text-white text-center" set:html={t.hero.headline} />

    <div class="text-center max-w-4xl mx-auto">

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10">
        {t.hero.subheadline}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a
          href={buildAppUrl('', currentLang)}
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl shadow-lg shadow-indigo-500/25 transition-all hover:shadow-indigo-500/40"
        >
          {t.hero.ctaPrimary}
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a
          href="#pricing"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-slate-300 bg-slate-800 hover:bg-slate-700 rounded-xl transition-colors"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>

      <!-- Demo: Scattered Script Cards                                      -->
      <!-- No rigid columns: each "row" shifts left/right by 50-90 px      -->
      <!-- so vertical card groups never align into straight columns.       -->
      <!-- y also varies 25-55 px within each cluster to avoid row lines.  -->
      <div class="relative mx-auto overflow-hidden" style="width: 820px; height: 362px;">

        <!-- ═══ z:1 — back ═══ -->

        <!-- Card — Belarusian  (top-right; row-1 right anchor) -->
        <div class="absolute" style="top: 12px; left: 545px; width: 262px; z-index: 1;">
          <div class="bg-slate-800/50 rounded-xl border border-slate-700/35 shadow-md px-5 py-4">
            <div class="text-sm font-mono text-slate-600 text-left mb-1 leading-snug">Vitaju, jak spravy?</div>
            <div class="text-base font-mono text-cyan-300 text-left leading-snug">Вітаю, як справы?</div>
          </div>
        </div>

        <!-- Card — Rusyn  (bottom; center shifted right vs Ukrainian) -->
        <div class="absolute" style="top: 250px; left: 268px; width: 258px; z-index: 1;">
          <div class="bg-slate-800/50 rounded-xl border border-slate-700/35 shadow-md px-5 py-4">
            <div class="text-sm font-mono text-slate-600 text-left mb-1 leading-snug">Zdorov, yak sia mash?</div>
            <div class="text-base font-mono text-rose-300 text-left leading-snug">Здоров, як ся маш?</div>
          </div>
        </div>

        <!-- Card — Lithuanian  (bottom-left; shifted right vs Bulgarian) -->
        <div class="absolute" style="top: 278px; left: 35px; width: 248px; z-index: 1;">
          <div class="bg-slate-800/50 rounded-xl border border-slate-700/35 shadow-md px-5 py-4">
            <div class="text-sm font-mono text-slate-600 text-left mb-1 leading-snug">Sveikas, kaip jus?</div>
            <div class="text-base font-mono text-lime-300 text-left leading-snug">Sveikas, kaip jūs?</div>
          </div>
        </div>

        <!-- ═══ z:2 — mid-back ═══ -->

        <!-- Card — Kazakh  (row-2 center; shifted 50 px right of Russian) -->
        <div class="absolute" style="top: 95px; left: 298px; width: 262px; z-index: 2;">
          <div class="bg-slate-800/60 rounded-xl border border-slate-700/45 shadow-md px-5 py-4">
            <div class="text-sm font-mono text-slate-500 text-left mb-1 leading-snug">Salam, qalynsyz ba?</div>
            <div class="text-base font-mono text-teal-300 text-left leading-snug">Салем, қалайсыз ба?</div>
          </div>
        </div>

        <!-- Card — Bulgarian  (row-3 left; flush left) -->
        <div class="absolute" style="top: 212px; left: 0; width: 258px; z-index: 2;">
          <div class="bg-slate-800/60 rounded-xl border border-slate-700/45 shadow-md px-5 py-4">
            <div class="text-sm font-mono text-slate-500 text-left mb-1 leading-snug">Zdraveyte, kak ste?</div>
            <div class="text-base font-mono text-purple-300 text-left leading-snug">Здравейте, как сте?</div>
          </div>
        </div>

        <!-- Card — Tajik  (bottom-right) -->
        <div class="absolute" style="top: 262px; left: 528px; width: 252px; z-index: 2;">
          <div class="bg-slate-800/60 rounded-xl border border-slate-700/45 shadow-md px-5 py-4">
            <div class="text-sm font-mono text-slate-500 text-left mb-1 leading-snug">Salom, chitor asti?</div>
            <div class="text-base font-mono text-orange-300 text-left leading-snug">Салом, чӣтавр ҳастӣ?</div>
          </div>
        </div>

        <!-- ═══ z:3 — mid ═══ -->

        <!-- Card — Ukrainian  (row-3 center; shifted 45 px LEFT of Russian) -->
        <div class="absolute" style="top: 155px; left: 205px; width: 272px; z-index: 3;">
          <div class="bg-slate-800/70 rounded-xl border border-slate-700/55 shadow-lg px-5 py-4">
            <div class="text-sm font-mono text-slate-500 text-left mb-1 leading-snug">Pryvit, yak spravy?</div>
            <div class="text-base font-mono text-blue-300 text-left leading-snug">Привіт, як справи?</div>
          </div>
        </div>

        <!-- ═══ z:4 — mid-front ═══ -->

        <!-- Card — Armenian  (row-2 left; shifted 55 px right of Georgian) -->
        <div class="absolute" style="top: 122px; left: 55px; width: 265px; z-index: 4;">
          <div class="bg-slate-800/78 rounded-xl border border-slate-700/65 shadow-lg px-5 py-4">
            <div class="text-sm font-mono text-slate-500 text-left mb-1 leading-snug">Barev, inchpes es?</div>
            <div class="text-base font-mono text-violet-300 text-left leading-snug">Բարև, ինչպե՞ս ես?</div>
          </div>
        </div>

        <!-- Card — Hebrew  (row-3 right; shifted 25 px left of Belarusian; RTL) -->
        <div class="absolute" style="top: 178px; left: 495px; width: 278px; z-index: 4;">
          <div class="bg-slate-800/78 rounded-xl border border-slate-700/65 shadow-lg px-5 py-4">
            <div class="text-sm font-mono text-slate-500 text-left mb-1 leading-snug">Shalom, ma shlomkha?</div>
            <div class="text-base font-mono text-emerald-300 leading-snug" dir="rtl">שלום, מה שלומך?</div>
          </div>
        </div>

        <!-- ═══ z:5 — near-front ═══ -->

        <!-- Card — Georgian  (top-left; flush left) -->
        <div class="absolute" style="top: 5px; left: 2px; width: 268px; z-index: 5;">
          <div class="bg-slate-800/88 rounded-xl border border-slate-700/75 shadow-xl px-5 py-4">
            <div class="text-sm font-mono text-slate-400 text-left mb-1 leading-snug">Gamarjoba, rogor khar?</div>
            <div class="text-base font-mono text-amber-300 text-left leading-snug">გამარჯობა, როგორ ხარ?</div>
          </div>
        </div>

        <!-- Card — Greek  (row-2 right; shifted 25 px left of Belarusian) -->
        <div class="absolute" style="top: 72px; left: 522px; width: 272px; z-index: 5;">
          <div class="bg-slate-800/88 rounded-xl border border-slate-700/75 shadow-xl px-5 py-4">
            <div class="text-sm font-mono text-slate-400 text-left mb-1 leading-snug">Yia sas, ti kanete?</div>
            <div class="text-base font-mono text-sky-300 text-left leading-snug">Γεια σας, τι κάνετε;</div>
          </div>
        </div>

        <!-- ═══ z:6 — front ═══ -->

        <!-- Card — Russian  (top-center; the one hero card) -->
        <div class="absolute" style="top: 32px; left: 248px; width: 282px; z-index: 6;">
          <div class="bg-slate-800 rounded-xl border border-slate-600 shadow-2xl px-5 py-4">
            <div class="text-sm font-mono text-slate-400 text-left mb-1 leading-snug">Privet, kak dela?</div>
            <div class="text-base font-mono text-indigo-300 text-left leading-snug">Привет, как дела?</div>
          </div>
        </div>

      </div>

      <!-- Trust Indicators -->
      <div class="mt-16 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm text-slate-500">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>{t.hero.trustBadge1}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>{t.hero.trustBadge2}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>{t.hero.trustBadge3}</span>
        </div>
      </div>
    </div>
  </div>
</section>

