---
/**
 * Footer component with links, legal info, and social media.
 */

interface Props {
  t: any;
}

const { t } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 border-t border-slate-800">
  <div class="w-full px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="inline-flex items-center gap-2 mb-4">
          <img src="/logo.png" alt="TranslitPro Logo" class="w-12 h-12" />
          <img src="/title.png" alt="TranslitPro" class="h-6" />
        </a>
        <p class="text-slate-400 text-sm leading-relaxed">
          {t.footer.tagline}
        </p>
      </div>

      <!-- Product Links -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{t.footer.product}</h4>
        <ul class="space-y-3">
          <li><a href="#features" class="text-slate-400 hover:text-white text-sm transition-colors">{t.nav.features}</a></li>
          <li><a href="#pricing" class="text-slate-400 hover:text-white text-sm transition-colors">{t.nav.pricing}</a></li>
          <li><a href="#faq" class="text-slate-400 hover:text-white text-sm transition-colors">{t.nav.faq}</a></li>
          <li><a href="https://app.translitpro.com" class="text-slate-400 hover:text-white text-sm transition-colors">{t.footer.openApp}</a></li>
        </ul>
      </div>

      <!-- Scripts Links -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{t.footer.scripts}</h4>
        <ul class="space-y-3">
          <li><a href="https://app.translitpro.com?lang=ru" class="text-slate-400 hover:text-white text-sm transition-colors">{t.footer.cyrillic}</a></li>
          <li><a href="https://app.translitpro.com?lang=he" class="text-slate-400 hover:text-white text-sm transition-colors">{t.footer.hebrew}</a></li>
          <li><a href="https://app.translitpro.com?lang=el" class="text-slate-400 hover:text-white text-sm transition-colors">{t.footer.greek}</a></li>
          <li><a href="https://app.translitpro.com?lang=ka" class="text-slate-400 hover:text-white text-sm transition-colors">{t.footer.georgian}</a></li>
          <li><a href="https://app.translitpro.com?lang=hy" class="text-slate-400 hover:text-white text-sm transition-colors">{t.footer.armenian}</a></li>
          <li><a href="https://app.translitpro.com" class="text-slate-400 hover:text-white text-sm transition-colors">{t.footer.custom}</a></li>
        </ul>
      </div>

      <!-- Legal Links -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{t.footer.legal}</h4>
        <ul class="space-y-3">
          <li><a href="https://app.translitpro.com/privacy" class="text-slate-400 hover:text-white text-sm transition-colors">{t.footer.privacyPolicy}</a></li>
          <li><a href="https://app.translitpro.com/terms" class="text-slate-400 hover:text-white text-sm transition-colors">{t.footer.termsOfService}</a></li>
        </ul>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-slate-500 text-sm text-center sm:text-left">
        <p>{t.footer.copyright.replace('{{year}}', currentYear.toString())}</p>
        <p class="mt-1">{t.footer.ownership}</p>
      </div>

      <!-- Social Links + Share -->
      <div class="flex items-center gap-3 flex-wrap justify-center sm:justify-end">

        <!-- Follow us -->
        <div class="flex items-center gap-2">
          <span class="text-slate-500 text-xs">{t.footer.followLabel}</span>
          <!-- Hidden until X page exists -->
          <a href="https://twitter.com/translitpro" class="hidden text-slate-400 hover:text-white transition-colors" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <!-- Facebook page -->
          <a href="https://www.facebook.com/profile.php?id=61585741537263" class="text-slate-400 hover:text-white transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>

        <!-- Divider -->
        <div class="w-px h-5 bg-slate-700" aria-hidden="true"></div>

        <!-- Share via -->
        <div class="flex items-center gap-2">
          <span class="text-slate-500 text-xs">{t.footer.shareLabel}</span>

          <!-- Copy link -->
          <div class="relative flex items-center">
            <button
              id="copy-link-btn"
              class="flex items-center text-slate-400 hover:text-white transition-colors"
              aria-label={t.footer.copyLink}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 0 0-5.656 0l-4 4a4 4 0 1 0 5.656 5.656l1.102-1.101m-.758-4.899a4 4 0 0 0 5.656 0l4-4a4 4 0 0 0-5.656-5.656l-1.1 1.1" />
              </svg>
            </button>
            <span
              id="copy-tooltip"
              class="absolute -top-9 left-1/2 -translate-x-1/2 bg-slate-700 text-white text-xs px-2 py-1 rounded opacity-0 transition-opacity duration-200 pointer-events-none whitespace-nowrap"
              aria-hidden="true"
            >
              {t.footer.linkCopied}
            </span>
          </div>

          <!-- Share on X -->
          <a
            href="https://twitter.com/intent/tweet?url=https%3A%2F%2Ftranslitpro.com&text=Type+in+Latin%2C+get+Cyrillic%2C+Hebrew%2C+Greek+%26+more.+Desktop+transliteration+for+13%2B+languages."
            class="text-slate-400 hover:text-white transition-colors"
            aria-label="Share on X"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>

          <!-- Share on Facebook -->
          <a
            href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Ftranslitpro.com"
            class="text-slate-400 hover:text-white transition-colors"
            aria-label="Share on Facebook"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- Share on Telegram -->
          <a
            href="https://t.me/share/url?url=https%3A%2F%2Ftranslitpro.com&text=Type+in+Latin%2C+get+Cyrillic%2C+Hebrew%2C+Greek+%26+more.+Desktop+transliteration+for+13%2B+languages."
            class="text-slate-400 hover:text-white transition-colors"
            aria-label="Share on Telegram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </a>

          <!-- Share on WhatsApp -->
          <a
            href="https://wa.me/?text=Type+in+Latin%2C+get+Cyrillic%2C+Hebrew%2C+Greek+%26+more.+Desktop+transliteration+for+13%2B+languages.+https%3A%2F%2Ftranslitpro.com"
            class="text-slate-400 hover:text-white transition-colors"
            aria-label="Share on WhatsApp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </div>
</footer>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const tooltip = document.getElementById('copy-tooltip');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('https://translitpro.com');
      if (tooltip) {
        tooltip.style.opacity = '1';
        setTimeout(() => { tooltip.style.opacity = '0'; }, 2000);
      }
    } catch {
      // Fallback for older browsers
      const ta = document.createElement('textarea');
      ta.value = 'https://translitpro.com';
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      if (tooltip) {
        tooltip.style.opacity = '1';
        setTimeout(() => { tooltip.style.opacity = '0'; }, 2000);
      }
    }
  });
</script>

